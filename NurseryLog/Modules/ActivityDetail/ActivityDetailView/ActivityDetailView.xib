<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24506" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_1" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24504"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="ActivityDetailView" customModule="NurseryLog" customModuleProvider="target">
            <connections>
                <outlet property="cardView" destination="adv-card" id="adv-out-card"/>
                <outlet property="categoryBadge" destination="adv-badge" id="adv-out-badge"/>
                <outlet property="contentView" destination="adv-content" id="adv-out-content"/>
                <outlet property="dateTimeLabel" destination="adv-dt" id="adv-out-dt"/>
                <outlet property="notesLabel" destination="adv-notes" id="adv-out-notes"/>
                <outlet property="separatorView" destination="adv-sep" id="adv-out-sep"/>
                <outlet property="titleLabel" destination="adv-title" id="adv-out-title"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" insetsLayoutMarginsFromSafeArea="NO" id="adv-content">
            <rect key="frame" x="0.0" y="0.0" width="414" height="300"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <subviews>
                <!-- Card view -->
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="adv-card">
                    <rect key="frame" x="16" y="16" width="382" height="268"/>
                    <subviews>
                        <!-- Outer vertical stack: top section + separator + notes -->
                        <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="adv-outer-stack">
                            <rect key="frame" x="16" y="16" width="350" height="236"/>
                            <subviews>
                                <!-- Top section: dateTime, badge row, title -->
                                <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="adv-top-stack">
                                    <subviews>
                                        <!-- dateTime label -->
                                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="adv-dt">
                                            <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                            <color key="textColor" red="0.50" green="0.50" blue="0.55" alpha="1" colorSpace="calibratedRGB"/>
                                        </label>
                                        <!-- Badge row: badge + spacer to keep badge left-aligned -->
                                        <stackView opaque="NO" contentMode="scaleToFill" spacing="0" translatesAutoresizingMaskIntoConstraints="NO" id="adv-badge-row">
                                            <subviews>
                                                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="adv-badge" customClass="CategoryBadgeView" customModule="NurseryLog" customModuleProvider="target">
                                                    <rect key="frame" x="0.0" y="0.0" width="86" height="21"/>
                                                </view>
                                                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="adv-badge-spacer">
                                                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                </view>
                                            </subviews>
                                        </stackView>
                                        <!-- Title -->
                                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="" lineBreakMode="wordWrap" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="adv-title">
                                            <fontDescription key="fontDescription" type="system" subtype="semibold" pointSize="17"/>
                                            <color key="textColor" red="0.15" green="0.15" blue="0.20" alpha="1" colorSpace="calibratedRGB"/>
                                        </label>
                                    </subviews>
                                </stackView>
                                <!-- Separator -->
                                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="adv-sep">
                                    <color key="backgroundColor" red="0.82" green="0.84" blue="0.87" alpha="1" colorSpace="calibratedRGB"/>
                                    <constraints>
                                        <constraint firstAttribute="height" constant="1" id="adv-sep-h"/>
                                    </constraints>
                                </view>
                                <!-- Notes -->
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="" lineBreakMode="wordWrap" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="adv-notes">
                                    <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                    <color key="textColor" red="0.50" green="0.50" blue="0.55" alpha="1" colorSpace="calibratedRGB"/>
                                </label>
                            </subviews>
                        </stackView>
                    </subviews>
                    <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                    <constraints>
                        <constraint firstItem="adv-outer-stack" firstAttribute="top" secondItem="adv-card" secondAttribute="top" constant="16" id="adv-cc1"/>
                        <constraint firstItem="adv-outer-stack" firstAttribute="leading" secondItem="adv-card" secondAttribute="leading" constant="16" id="adv-cc2"/>
                        <constraint firstAttribute="trailing" secondItem="adv-outer-stack" secondAttribute="trailing" constant="16" id="adv-cc3"/>
                        <constraint firstAttribute="bottom" secondItem="adv-outer-stack" secondAttribute="bottom" constant="16" id="adv-cc4"/>
                    </constraints>
                </view>
            </subviews>
            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
                <constraint firstItem="adv-card" firstAttribute="top" secondItem="adv-content" secondAttribute="top" constant="16" id="adv-c1"/>
                <constraint firstItem="adv-card" firstAttribute="leading" secondItem="adv-content" secondAttribute="leading" constant="16" id="adv-c2"/>
                <constraint firstAttribute="trailing" secondItem="adv-card" secondAttribute="trailing" constant="16" id="adv-c3"/>
                <constraint firstAttribute="bottom" secondItem="adv-card" secondAttribute="bottom" constant="16" id="adv-c4"/>
            </constraints>
            <freeformSimulatedSizeMetrics key="simulatedDestinationMetrics"/>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </view>
    </objects>
</document>
