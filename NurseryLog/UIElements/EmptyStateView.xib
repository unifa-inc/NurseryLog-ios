<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24506" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_1" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="esv-root" customClass="EmptyStateView" customModule="NurseryLog" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="400" height="600"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <subviews>
                <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="NotFound" translatesAutoresizingMaskIntoConstraints="NO" id="esv-icon">
                    <rect key="frame" x="100" y="197" width="200" height="200"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="200" id="esv-icon-h"/>
                        <constraint firstAttribute="width" constant="200" id="esv-icon-w"/>
                    </constraints>
                </imageView>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="esv-label">
                    <rect key="frame" x="16" y="405" width="368" height="0.0"/>
                    <fontDescription key="fontDescription" type="system" pointSize="14"/>
                </label>
            </subviews>
            <viewLayoutGuide key="safeArea" id="esv-safe"/>
            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
                <constraint firstItem="esv-icon" firstAttribute="centerX" secondItem="esv-safe" secondAttribute="centerX" id="esv-c1"/>
                <constraint firstItem="esv-icon" firstAttribute="centerY" secondItem="esv-safe" secondAttribute="centerY" constant="-50" id="esv-c2"/>
                <constraint firstItem="esv-label" firstAttribute="top" secondItem="esv-icon" secondAttribute="bottom" constant="8" id="esv-c3"/>
                <constraint firstItem="esv-label" firstAttribute="leading" secondItem="esv-safe" secondAttribute="leading" constant="16" id="esv-c4"/>
                <constraint firstItem="esv-safe" firstAttribute="trailing" secondItem="esv-label" secondAttribute="trailing" constant="16" id="esv-c5"/>
            </constraints>
            <freeformSimulatedSizeMetrics key="simulatedDestinationMetrics"/>
            <connections>
                <outlet property="iconImageView" destination="esv-icon" id="esv-out-icon"/>
                <outlet property="messageLabel" destination="esv-label" id="esv-out-label"/>
            </connections>
        </view>
    </objects>
    <resources>
        <image name="NotFound" width="200" height="200"/>
    </resources>
</document>
